# ---- Wati ----
# Base URL INCLUDING your tenant id, e.g. https://live-mt-server.wati.io/1234567
WATI_BASE_URL=
# API token from Wati: Connector > API > Create API Token
WATI_API_TOKEN=
# Random string. Add it to the webhook URL in Wati as ?key=<this value>
WEBHOOK_SECRET=

# ---- Behaviour ----
# true = log what would be sent, send nothing. Flip to false only after testing.
DRY_RUN=true
VENDOR_SIGNUP_URL=https://saffron.planningstudio.in/vendor-onboarding

# ---- Lead follow-up (Google Sheet) ----
LEADS_SHEET_ID=1iWFR1h9Bb-SW10hsPEuf2GD6mHFItkBlQlt_Ch7JfKI
LEADS_SHEET_TAB=Sheet1
# Only rows at or below this number are NEVER contacted. Rows after it are eligible.
# Leave empty and the follow-up job does nothing (safety for old leads).
FOLLOWUP_FROM_ROW=
# Approved Wati template used for the follow-up (see README for the text)
LEAD_TEMPLATE_NAME=lead_followup_v1
MAX_PER_RUN=10
# Service account JSON (single line). Share the sheet with its email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Optional ----
# Planning Studio MCP (not wired yet, see README)
PLANNING_STUDIO_MCP_URL=
PLANNING_STUDIO_MCP_TOKEN=

# ---- Claude-powered replies (optional; without a key, keyword rules only) ----
# Key from platform.claude.com. Max 5x/20x plans can claim monthly API credits:
# claude.ai > Settings > Billing > API credits, then link a Console organization.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Templates and team alert ----
FINISH_TEMPLATE_NAME=lead_finish_v1
QUIET_TEMPLATES=quiet_followup_1,quiet_followup_2,quiet_followup_3
# WhatsApp number (with country code, digits only) that gets the 9:30 IST morning summary
TEAM_ALERT_NUMBER=
TEAM_DIGEST_TEMPLATE=team_digest_v1

# ---- Timings (confirmed defaults) ----
QUIET_AFTER_HOURS=12
COLD_AFTER_DAYS=3
INSTANT_MINUTES=30
SEND_FROM_HOUR=10
SEND_TO_HOUR=20

# ---- ManyChat (Pro plan or higher): Instagram step-in ----
MANYCHAT_API_TOKEN=
IG_WINDOW_HOURS=23
IG_LAST_CHANCE_HOURS=20

# ---- Daily summary to you ----
# WhatsApp number (country code, digits only) and the approved template
OWNER_NUMBER=
OWNER_SUMMARY_TEMPLATE=owner_summary_v1

# Your WhatsApp Business number in Wati (digits, with country code). Wati requires it on template sends.
WATI_CHANNEL_NUMBER=
